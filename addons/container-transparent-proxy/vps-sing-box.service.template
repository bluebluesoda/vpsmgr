[Unit]
Description=sing-box transparent proxy for vpsmgr containers
After=network-online.target incus.service
Wants=network-online.target

[Service]
Type=simple
User=sing-box
Group=sing-box
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=true
ExecStartPre=/bin/sh -c '/sbin/ip rule add pref 10011 from __SUBNET__ lookup 51821 2>/dev/null || true; /sbin/ip route add __SUBNET__ dev __BRIDGE__ table 51821 2>/dev/null || true; /sbin/ip route add 100.64.0.0/10 dev tailscale0 table 51821 2>/dev/null || true; /sbin/ip route add 192.168.0.0/16 dev __EXT_IF__ table 51821 2>/dev/null || true; /sbin/ip route add __PROXY_SERVER_IP__/32 via __EXT_GW__ dev __EXT_IF__ table 51821 2>/dev/null || true'
ExecStartPre=/bin/sh -c '/usr/sbin/nft add table ip vpsproxy 2>/dev/null || true; /usr/sbin/nft -c -f /etc/sing-box/vpsproxy.nft'
ExecStartPre=/usr/sbin/nft -f /etc/sing-box/vpsproxy.nft
ExecStartPre=/usr/local/bin/sing-box check -c /etc/sing-box/config.json
ExecStart=/usr/local/bin/sing-box run -c /etc/sing-box/config.json
ExecStartPost=/bin/sh -c 'for i in 1 2 3 4 5; do /sbin/ip route add default dev vpsmgr-tun table 51821 2>/dev/null && exit 0; sleep 1; done; exit 1'
ExecStopPost=/bin/sh -c '/usr/sbin/nft delete table ip vpsproxy 2>/dev/null || true; /sbin/ip route flush table 51821 2>/dev/null || true; /sbin/ip rule del pref 10011 from __SUBNET__ lookup 51821 2>/dev/null || true'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
