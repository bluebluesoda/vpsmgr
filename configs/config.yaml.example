# vpsmgr config example — generated at /etc/vpsmgr/config.yaml on install
panel:
  listen: ":8443"           # a FRESH install picks a random free port in 2000-9999;
                            # this line is where it lands (change it only if you know why)
  cert: /etc/vpsmgr/panel.crt
  key: /etc/vpsmgr/panel.key
  db: /etc/vpsmgr/vpsmgr.db
  public_ip: AUTO          # NIC IPv4 used by firewall/routing (private on NAT-ing clouds like AWS/Alibaba)
  display_ip: AUTO         # optional: public IPv4 for DISPLAY ONLY (panel URL / SSH hints);
                           # auto-fetched from ipv4.ip.sb when public_ip is private; empty = fall back to public_ip
  session_days: 3
  url_path: AUTO           # 10-char random [a-zA-Z0-9_-] secret prefix, generated once at install
  admin_url_path: AUTO     # 10-char random secret prefix for the ADMIN panel; can be
                           # changed later or set to empty to disable the admin panel
   admin_pass_hash: AUTO    # bcrypt hash of the admin panel password; generated at install,
                            # reset via `vps admin-passwd`. No admin username — password only.

net:
  # Container subnet 10.<n>.0.0/24, chosen ONCE at install (second octet n,
  # default 115). Immutable: changing it after install breaks existing
  # containers. The port scheme is fixed too: each container gets a random SSH
  # port from 30000-31999 plus a whole-hundred block of 100 user ports
  # (10000-29999), up to 200 containers.
  subnet: "10.115.0.0/24"
  gateway: "10.115.0.1"
  v4_forward: true            # IPv4 inbound policy. false (only meaningful with
                              # ipv6_subnet set) = containers are IPv6-only: no
                              # SSH/port-block DNAT and traefik/domains disabled
                              # (NAT4 outbound kept). Toggle at runtime: vps config set net.v4_forward true|false
  ext_if: AUTO             # detected from default route
  ipv6_subnet: ""          # optional: global prefix for IPv6 pass-through, e.g. "2602:fada:6::/64".
                           # /64 or shorter works (e.g. /56); a provider /80 slice like
                           # "2406:da14:1dd2:a807:753a::/80" is also supported.
                           # empty = IPv6 disabled (default). Containers get global
                           # addresses via SLAAC; no NAT; set at install time.

incus:
  image: "vpsmgr/debian-sshd"
  image_fallback: "images:debian/13"
  pool: vpsmgr
  bridge: incusbr0
